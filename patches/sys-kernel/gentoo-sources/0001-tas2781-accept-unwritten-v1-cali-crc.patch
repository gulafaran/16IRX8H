+/* The V1 UEFI calibration layout has room for exactly four devices. */
+#define TASDEV_CALI_V1_DEV_MAX		4
+
+/*
+ * Some BIOSes write the per-device records produced by end-of-line
+ * calibration into the V1 UEFI layout, but never populate the trailing
+ * timestamp and CRC words and leave both of them zero. Seen on the Lenovo
+ * Legion Pro 7 16IRX8H (codec SSID 17aa:3884), where the resulting CRC
+ * mismatch makes the driver discard perfectly valid factory calibration and
+ * fall back to running the speaker protection algorithm on defaults.
+ *
+ * Only accept the "CRC was never written" case, never "CRC is wrong": both
+ * trailing words have to be zero, and every record that will actually be
+ * consumed has to carry non-zero data, so that an erased or never-calibrated
+ * block is still rejected.
+ */
+static bool tas2781_cali_v1_crc_unwritten(struct tasdevice_priv *p,
+	unsigned int *tmp_val)
+{
+	int i, j;
+
+	if (p->ndev > TASDEV_CALI_V1_DEV_MAX)
+		return false;
+
+	/* Both the timestamp and the CRC must be absent, not merely wrong. */
+	if (tmp_val[20] || tmp_val[21])
+		return false;
+
+	for (i = 0; i < p->ndev; i++) {
+		for (j = 0; j < TASDEV_CALIB_N; j++) {
+			if (tmp_val[i * TASDEV_CALIB_N + j])
+				break;
+		}
+		if (j == TASDEV_CALIB_N)
+			return false;
+	}
+
+	dev_warn(p->dev,
+		"%s: BIOS left V1 calibration CRC unwritten, using data as-is\n",
+		__func__);
+
+	return true;
+}
